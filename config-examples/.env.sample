# ShipFeeder receiver and webpage related parameters:
FEEDER_LAT=xx.xxxxxx
FEEDER_LONG=yy.yyyyyy
RTLSDR_DEVICE_SERIAL=DEVICE-SERIAL
RTLSDR_DEVICE_DESCRIPTION=
RTLSDR_DEVICE_GAIN=xxx
RTLSDR_DEVICE_PPM=xxx
AISCATCHER_DECODER_AFC_WIDE=on
STATION_NAME=My&nbsp;Station&nbsp;Name
# Optional custom outputs. Generated connection metadata uses generic defaults
# unless the destination is one of the known aggregators.
UDP_FEEDS=
TCP_FEEDS=
# Incoming UDP and TCP listeners:
AISCATCHER_UDP_INPUTS=
AISCATCHER_TCP_INPUTS=
# GPS inputs (optional):
AISCATCHER_GPS_SERIAL=
AISCATCHER_GPSD_PORT=
# Example: UDP_FEEDS=ais.example.net:10110
# Example: TCP_FEEDS=ais.example.net:10110
# Examples: AISCATCHER_UDP_INPUTS=:9988:Local AIS,127.0.0.1:9989
# Examples: AISCATCHER_TCP_INPUTS=:9988::Remote AIS,127.0.0.1:9989:N2K:Gateway
AISCATCHER_MQTT_URL=
AISCATCHER_MQTT_CLIENT_ID=
AISCATCHER_MQTT_QOS=
AISCATCHER_MQTT_TOPIC=
AISCATCHER_MQTT_MSGFORMAT=JSON_FULL
# Shared output filters (leave empty to use AIS-catcher defaults):
AISCATCHER_FILTER_ALLOW_TYPE=
AISCATCHER_FILTER_BLOCK_TYPE=
AISCATCHER_FILTER_ALLOW_REPEAT=
AISCATCHER_FILTER_BLOCK_REPEAT=
AISCATCHER_FILTER_ALLOW_MMSI=
AISCATCHER_FILTER_BLOCK_MMSI=
AISCATCHER_FILTER_ALLOW_CHANNEL=
AISCATCHER_FILTER_ID=
AISCATCHER_FILTER_GPS=
AISCATCHER_FILTER_AIS=
AISCATCHER_FILTER_REMOVE_EMPTY=
AISCATCHER_FILTER_UNIQUE=true
AISCATCHER_FILTER_POSITION_INTERVAL=
AISCATCHER_FILTER_OWN_INTERVAL=
#
# keys and params for aggregators:
# If you aren't feeding a specific aggregator, leave the value EMPTY or remove the parameter
ADSBITALIA_STATION_ID=xxxxx
AIRFRAMES_STATION_ID=XX-XXXXXXX-AIS
AISCATCHER_FEEDER_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AISCOMMONS_UDP_PORT=xxxxx
AISCOMMONS_SHAREDATA=
AISFRIENDS_UDP_PORT=xxxxx
AISHUB_UDP_PORT=xxxx
AISTRAIL_FEEDER_KEY=xxxxxx
APRSFI_FEEDER_KEY=xxxxxxx
APRSFI_STATION_ID=MYCALL
BOATBEACON_SHAREDATA=true
GANGWAY_SHAREDATA=true
HPRADAR_UDP_PORT=xxxxx
MARINETRAFFIC_UDP_PORT=xxxxx
MASTCHAIN_STATION_ID=
MASTCHAIN_FEEDER_KEY=
MYSHIPTRACKING_UDP_PORT=xxxxx
OPENWATERS_SHAREDATA=true
OPENWATERS_FEEDER_KEY=
OPENWATERS_STATION_ID=My Station
PELYR_STATION_ID=
PELYR_FEEDER_KEY=
PELYR_UDP_PORT=
RADARVIRTUEL_FEEDER_KEY=xxxxxxxxx
RADARVIRTUEL_STATION_ID=xx
SKYDEX_FEEDER_KEY=
SHIPFINDER_SHAREDATA=true
SHIPPINGEXPLORER_UDP_PORT=xxxxx
SHIPXPLORER_SHARING_KEY=xxxxxxxxxxxxxxxxxxx
SHIPXPLORER_SERIAL_NUMBER=SXTRPI00xxxx
VESSELFINDER_UDP_PORT=xxxxx
VESSELTRACKER_UDP_PORT=xxxxx
