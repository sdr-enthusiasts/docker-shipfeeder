#!/bin/bash
# shellcheck shell=bash

target_hostname() {
    local target="$1"
    target="${target#*://}"
    target="${target%%/*}"
    target="${target%%\?*}"
    target="${target%%\#*}"
    target="${target##*@}"
    if [[ "$target" == \[*\]* ]]; then
        target="${target#\[}"
        target="${target%%\]*}"
    else
        target="${target%%:*}"
    fi
    printf '%s' "$target"
}

hostname_resolves() {
    local hostname answer type
    hostname="$(target_hostname "$1")"
    [[ -n "$hostname" ]] || return 1
    if [[ "$hostname" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$hostname" == *:* ]]; then
        getent ahosts -- "$hostname" >/dev/null 2>&1 ||
            getent --no-addrconfig ahosts -- "$hostname" >/dev/null 2>&1
        return $?
    fi
    for type in A AAAA; do
        answer="$(dig +short +search +time=2 +tries=1 -q "$hostname" -t "$type" 2>/dev/null)" || continue
        if grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$|^[0-9a-fA-F:]*:[0-9a-fA-F:]+$' <<< "$answer"; then
            return 0
        fi
    done
    return 1
}
